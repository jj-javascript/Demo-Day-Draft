<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- <link rel="stylesheet" href="public/style.css"> -->
    <link rel="stylesheet" href="style.css">
        <title>Compilr</title>
  </head>
  <body>
    <h1>Welcome Back to Compilr</h1>

    <form action="/quotes" method="POST">
        <input type="url" placeholder="Feed me some content" name="name">
        <!-- <input type="text" placeholder="quote" name="quote"> -->
        <select>
        <option calue="" disabled selected>Select Your Feed</option>
        </select>
        <button type="submit"> Submit </button>
    </form>

    
    <div id="message"></div>
    
    <h2>Articles</h2>
    
    <ul class="quotes">
      <!-- Loop through quotes -->
      <% for(var i = 0; i < quotes.length; i++) {%>
        <li class="quote">
          <!-- Output name from the iterated quote object -->
          <span><a href="<%= quotes[i].url %>"><%= quotes[i].title %></a></span>:
          <!-- Output quote from the iterated quote object -->
          <span><%= quotes[i].description %></span>
          <span class="entryID" id="entryID"><%= quotes[i]._id %></span>
          <button id="update-button">Update</button>
          <button id="delete-button">Delete</button>
        </li>
        <% } %>
      </ul>
      <script src="/main.js"></script>
  </body>
</html>